{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shortcuts-doctor",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "shortcuts.andernet.dev", "custom_domain": true }],
}
