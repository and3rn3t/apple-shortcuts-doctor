{
  "name": "shortcuts-doctor",
  "version": "0.2.0",
  "description": "Command-line static inspector for Apple Shortcut exports.",
  "type": "module",
  "exports": {
    ".": "./dist/shortcuts-doctor.mjs"
  },
  "bin": {
    "shortcuts-doctor": "./dist/shortcuts-doctor.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@shortcuts-doctor/core": "workspace:*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://github.com/and3rn3t/apple-shortcuts-doctor/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/and3rn3t/apple-shortcuts-doctor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/and3rn3t/apple-shortcuts-doctor.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "node ../../scripts/build-cli.mjs"
  },
  "keywords": [
    "apple-shortcuts",
    "shortcuts",
    "static-analysis",
    "privacy",
    "security"
  ]
}
