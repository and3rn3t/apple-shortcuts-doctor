{
  "name": "shortcuts-doctor-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:skill && pnpm build:cli",
    "build:skill": "node scripts/build-skill.mjs",
    "build:skill:check": "node scripts/build-skill.mjs --check",
    "test": "node scripts/build-cli.mjs && vitest run",
    "test:watch": "node scripts/build-cli.mjs && vitest",
    "test:coverage": "node scripts/build-cli.mjs && vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc -p packages/core && tsc -p packages/cli && tsc -p apps/web && tsc -p .",
    "validate": "pnpm lint && pnpm format:check && pnpm type-check && pnpm build:cli && pnpm --filter @shortcuts-doctor/web build && pnpm test:coverage && pnpm build:skill:check && pnpm changelog check",
    "prepare": "husky",
    "build:cli": "node scripts/build-cli.mjs",
    "smoke:pack": "scripts/smoke-pack.sh",
    "changelog": "node scripts/changelog.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
